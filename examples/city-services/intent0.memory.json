nchor":"streets-transport","text":"Report a problem Road works Street lighting Snow clearing","code":[],"topics":["riverton","city","service","all","category","street","transport","light","road","snow"]},{"id":"s4","page":"p1","path":["Riverton City Services","All services by category","Records"],"anchor":"records","text":"Birth certificates Marriage records Death records Property records","code":[],"topics":["riverton","city","service","all","category","record","marriage","death","property"]},{"id":"s5","page":"p1","path":["Riverton City Services","All services by category","Business"],"anchor":"business","text":"Licences Food permits Signs & awnings Tenders","code":[],"topics":["riverton","city","service","all","category","business","food","awning","tender","sign","licence"]},{"id":"s6","page":"p1","path":["Riverton City Services","All services by category","Help"],"anchor":"help","text":"Track a request Fees Water connection documents Birth certificate help Contact us","code":[],"topics":["riverton","city","service","all","category","help","track","request","contact"]},{"id":"s7","page":"p1","path":["Riverton City Services","News"],"anchor":"news","text":"12 Oct Leaf collection starts in all wards next week.\n8 Oct New opening hours for the Records Office.\n1 Oct Winter parking rules apply from 1 December.","code":[],"topics":["next","riverton","city","service","new","leaf","ward","week","winter"]},{"id":"s8","page":"p2","path":["Water & sewer"],"anchor":"water-sewer","text":"The Riverton Water Department supplies drinking water to every home and business in the city.","code":[],"topics":["water","sewer","supplie","drink","every"]},{"id":"s9","page":"p3","path":["All services A–Z"],"anchor":"all-services-az","text":"Can't find what you need? Most services are listed under a department. Start with the department, then choose the service.","code":[],"topics":["all","service","department","list","under","then","find"]},{"id":"s10","page":"p3","path":["All services A–Z","Bins & recycling"],"anchor":"bins","text":"Collection days, replacement bins and bulky items.","code":[],"topics":["all","service","bin","recycl","replacement","bulky","item","collection"]},{"id":"s11","page":"p3","path":["All services A–Z","Parking permits"],"anchor":"parking","text":"Resident, visitor and business permits.","code":[],"topics":["all","service","park","permit","visitor","resident","business"]},{"id":"s12","page":"p3","path":["All services A–Z","Libraries"],"anchor":"libraries","text":"Branches, cards and opening hours.","code":[],"topics":["all","service","librarie","branche","card","hour","open"]},{"id":"s13","page":"p3","path":["All services A–Z","Pets & animals"],"anchor":"pets","text":"Dog licences and lost pets.","code":[],"topics":["all","service","pet","animal","lost","licence"]},{"id":"s14","page":"p3","path":["All services A–Z","Road works"],"anchor":"roadworks","text":"Planned closures and diversions.","code":[],"topics":["all","service","road","work","plann","closure","diversion"]},{"id":"s15","page":"p3","path":["All services A–Z","Snow clearing"],"anchor":"snow","text":"Priority routes and sidewalk rules.","code":[],"topics":["all","service","snow","clear","priority","route","sidewalk"]},{"id":"s16","page":"p3","path":["All services A–Z","Marriage records"],"anchor":"marriage","text":"Copies of marriage certificates.","code":[],"topics":["all","service","marriage","record","copie","certificate"]},{"id":"s17","page":"p3","path":["All services A–Z","Death records"],"anchor":"death","text":"Registering a death and ordering copies.","code":[],"topics":["all","service","death","record","register","order","copie"]},{"id":"s18","page":"p3","path":["All services A–Z","Property records"],"anchor":"property","text":"Ownership and assessment history.","code":[],"topics":["all","service","property","record","assessment","history","ownership"]},{"id":"s19","page":"p3","path":["All services A–Z","Business licences"],"anchor":"licences","text":"New licences and renewals.","code":[],"topics":["all","service","business","licence","renewal"]},{"id":"s20","page":"p3","path":["All services A–Z","Food permits"],"anchor":"food","text":"Restaurants, food trucks and markets.","code":[],"topics":["all","service","food","permit","restaurant","truck","market"]},{"id":"s21","page":"p3","path":["All services A–Z","Signs & awnings"],"anchor":"signs","text":"Permits for signs on buildings.","code":[],"topics":["all","service","sign","awning","building","permit"]},{"id":"s22","page":"p3","path":["All services A–Z","Tenders"],"anchor":"tenders","text":"Open contracts and how to bid.","code":[],"topics":["all","service","tender","contract","open"]},{"id":"s23","page":"p3","path":["All services A–Z","Contact us"],"anchor":"contact","text":"Call 311 or visit 100 Main Street.","code":[],"topics":["all","service","contact","call","visit","main","street"]},{"id":"s24","page":"p4","path":["Report a problem on a street"],"anchor":"report-a-problem-on-a-street","text":"Potholes, broken streetlights, overflowing bins or graffiti on public property.","code":[],"topics":["report","problem","street","overflow","public","pothole","broken","streetlight"]},{"id":"s25","page":"p5","path":["Order a copy of a birth certificate"],"anchor":"order-a-copy-of-a-birth-certificate","text":"For births registered in Riverton. Copies cost $12 each. See birth certificate help.","code":[],"topics":["order","copy","birth","certificate","each","register"]},{"id":"s26","page":"p7","path":["Fees","Water connection fees"],"anchor":"water","text":"A residential water connection costs $350, including the first inspection. A commercial connection costs $900. A repeat inspection costs $75.","code":[],"topics":["fee","water","connection","cost","inspection","residential","includ"]},{"id":"s27","page":"p7","path":["Fees","Records fees"],"anchor":"records","text":"A certified copy of a birth, marriage or death certificate costs $12 per copy. Express printing (same day) costs $20 extra.","code":[],"topics":["express","fee","record","cost","copy","certifi","same","extra"]},{"id":"s28","page":"p7","path":["Fees","Street reports"],"anchor":"streets","text":"Reporting a pothole, broken streetlight, garbage or graffiti is free.","code":[],"topics":["fee","street","report","garbage","free","pothole","broken"]},{"id":"s29","page":"p8","path":["Documents for a new water connection","If you own the property"],"anchor":"owners","text":"Bring proof of ownership (a property deed or tax bill from the last 12 months) and photo ID. For a new building you also need the building permit number.","code":[],"topics":["document","new","water","connection","own","property","build","bring","deed","bill"]},{"id":"s30","page":"p8","path":["Documents for a new water connection","If you rent"],"anchor":"tenants","text":"The property owner must apply, or you need a signed letter from the owner that allows you to apply on their behalf, with a copy of their photo ID.","code":[],"topics":["document","new","water","connection","rent","owner","their","apply","must"]},{"id":"s31","page":"p8","path":["Documents for a new water connection","For businesses"],"anchor":"business","text":"Commercial connections also need your business licence number and an estimate of daily water use.","code":[],"topics":["document","new","water","connection","businesse","estimate","daily","commercial"]},{"id":"s32","page":"p8","path":["Documents for a new water connection","How long it takes"],"anchor":"timing","text":"An inspector calls within 3 working days. Most homes are connected within 10 working days after the inspection is passed.","code":[],"topics":["document","new","water","connection","long","take","within","work","inspector","connect","after"]},{"id":"s33","page":"p9","path":["Birth certificate help","Who can order a copy"],"anchor":"who","text":"The person named on the certificate, their parents, or a legal guardian. You need to verify your phone number before ordering.","code":[],"topics":["birth","certificate","help","who","order","copy","person","parent","legal","guardian"]},{"id":"s34","page":"p9","path":["Birth certificate help","How long it takes"],"anchor":"time","text":"Copies are printed within 2 working days and mailed to the address on file. Same-day express printing is available at the Records Office.","code":[],"topics":["express","birth","certificate","help","long","take","print","mail","address","file","same-day"]},{"id":"s35","page":"p9","path":["Birth certificate help","Corrections"],"anchor":"corrections","text":"To correct a mistake on a birth certificate, visit the Records Office at 100 Main Street with photo ID and supporting documents.","code":[],"topics":["birth","certificate","help","correction","correct","mistake","support"]},{"id":"s36","page":"p10","path":["Apply for a new water connection"],"anchor":"apply-for-a-new-water-connection","text":"Before you start, have your proof of ownership ready. See documents you need.","code":[],"topics":["apply","new","water","connection","have","ready","before","proof","start"]}],"links":[["p1","p2"],["p1","p3"],["p1","p4"],["p1","p5"],["p1","p6"],["p1","p7"],["p1","p8"],["p1","p9"],["p1","p10"],["p2","p1"],["p2","p3"],["p2","p4"],["p2","p5"],["p2","p6"],["p2","p7"],["p2","p8"],["p2","p9"],["p2","p10"],["p3","p1"],["p3","p2"],["p3","p4"],["p3","p5"],["p3","p6"],["p3","p7"],["p3","p8"],["p3","p9"],["p3","p10"],["p4","p1"],["p4","p2"],["p4","p3"],["p4","p5"],["p4","p6"],["p4","p7"],["p4","p8"],["p4","p9"],["p4","p10"],["p5","p1"],["p5","p2"],["p5","p3"],["p5","p4"],["p5","p6"],["p5","p7"],["p5","p8"],["p5","p9"],["p5","p10"],["p6","p1"],["p6","p2"],["p6","p3"],["p6","p4"],["p6","p5"],["p6","p7"],["p6","p8"],["p6","p9"],["p6","p10"],["p7","p1"],["p7","p2"],["p7","p3"],["p7","p4"],["p7","p5"],["p7","p6"],["p7","p8"],["p7","p9"],["p7","p10"],["p8","p1"],["p8","p2"],["p8","p3"],["p8","p4"],["p8","p5"],["p8","p6"],["p8","p7"],["p8","p9"],["p8","p10"],["p9","p1"],["p9","p2"],
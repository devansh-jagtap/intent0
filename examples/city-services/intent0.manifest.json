{
  "schemaVersion": 1,
  "site": { "id": "riverton_city", "name": "Riverton City Services", "baseUrl": "http://localhost:5050" },
  "revision": 1,
  "status": "approved",
  "model": { "provider": "groq", "model": "openai/gpt-oss-120b" },
  "flows": [
    {
      "id": "water_connection",
      "title": "Apply for a new water connection",
      "description": "Apply for a new water supply connection for a home or business in Riverton.",
      "examples": ["I need water connected at my new house", "new water connection", "get water supply for my shop", "apply for a water connection"],
      "enabled": true,
      "irreversible": false,
      "auth": "public",
      "fallbackPath": "/services/water-connection",
      "steps": [
        {
          "id": "applicant",
          "title": "Your details and property",
          "kind": "form",
          "fields": [
            { "name": "fullName", "label": "Full name", "type": "text", "required": true },
            { "name": "phone", "label": "Phone number", "type": "phone", "required": true },
            { "name": "address", "label": "Property address", "type": "text", "required": true },
            { "name": "connectionType", "label": "Connection type", "type": "select", "required": true, "options": [ { "value": "residential", "label": "Residential" }, { "value": "commercial", "label": "Commercial" } ] }
          ],
          "action": { "method": "POST", "path": "/api/water/connection", "sends": ["fullName", "phone", "address", "connectionType"], "returns": ["referenceId", "status"] },
          "needs": []
        }
      ],
      "alsoNeed": { "text": "Have proof of ownership (deed or recent tax bill) and photo ID ready for the inspector's visit.", "approved": true }
    },
    {
      "id": "report_problem",
      "title": "Report a problem on a street",
      "description": "Report a pothole, broken streetlight, overflowing bin, dumped garbage or graffiti on a public street.",
      "examples": ["there is a pothole on my street", "the streetlight outside my house is broken", "report garbage dumped on the road", "report graffiti"],
      "enabled": true,
      "irreversible": false,
      "auth": "public",
      "fallbackPath": "/services/report-a-problem",
      "steps": [
        {
          "id": "report",
          "title": "What and where",
          "kind": "form",
          "fields": [
            { "name": "issueType", "label": "What is the problem?", "type": "select", "required": true, "options": [ { "value": "pothole", "label": "Pothole" }, { "value": "streetlight", "label": "Broken streetlight" }, { "value": "garbage", "label": "Overflowing bin or dumped garbage" }, { "value": "graffiti", "label": "Graffiti" } ] },
            { "name": "location", "label": "Where is it?", "type": "text", "required": true, "help": "Street and nearest house number or landmark" },
            { "name": "details", "label": "Anything else we should know?", "type": "textarea", "required": false },
            { "name": "phone", "label": "Phone, if you want an update", "type": "phone", "required": false }
          ],
          "action": { "method": "POST", "path": "/api/streets/report", "sends": ["issueType", "location", "details", "phone"], "returns": ["referenceId", "status"] },
          "needs": []
        }
      ]
    },
    {
      "id": "birth_certificate",
      "title": "Order a copy of a birth certificate",
      "description": "Order certified copies of a birth certificate for a birth registered in Riverton. Copies cost $12 each.",
      "examples": ["I need a copy of my birth certificate", "order birth certificate", "get my son's birth certificate copy"],
      "enabled": true,
      "irreversible": true,
      "auth": "public",
      "fallbackPath": "/services/birth-certificate",
      "steps": [
        {
          "id": "verify_phone",
          "title": "Verify your phone",
          "kind": "verify",
          "fields": [ { "name": "phone", "label": "Phone number", "type": "phone", "required": true } ],
          "action": { "method": "POST", "path": "/api/records/verify-phone", "sends": ["phone"], "returns": ["otpRequestId"] },
          "needs": []
        },
        {
          "id": "certificate",
          "title": "Certificate details",
          "kind": "review",
          "fields": [
            { "name": "otp", "label": "6-digit code", "type": "otp", "required": true, "pattern": "^\\d{6}$" },
            { "name": "childName", "label": "Full name on the certificate", "type": "text", "required": true },
            { "name": "dateOfBirth", "label": "Date of birth", "type": "date", "required": true },
            { "name": "copies", "label": "Number of copies", "type": "number", "required": true, "help": "1 to 5 copies, $12 each" }
          ],
          "action": { "method": "POST", "path": "/api/records/birth-certificate", "sends": ["otpRequestId", "otp", "childName", "dateOfBirth", "copies"], "returns": ["referenceId", "status", "fee"] },
          "needs": ["otpRequestId"]
        }
      ]
    },
    {
      "id": "track_request",
      "title": "Track a request",
      "description": "Check the status of a water connection, street report or certificate order with its reference.",
      "examples": ["what is the status of my request", "track WTR-2026-04101", "where is my application"],
      "enabled": true,
      "irreversible": false,
      "auth": "public",
      "fallbackPath": "/track",
      "steps": [
        {
          "id": "lookup",
          "title": "Your reference",
          "kind": "form",
          "fields": [ { "name": "referenceId", "label": "Reference", "type": "text", "required": true, "help": "For example WTR-2026-04101" } ],
          "action": { "method": "GET", "path": "/api/status/{referenceId}", "sends": ["referenceId"], "returns": ["request", "status"] },
          "needs": []
        }
      ]
    }
  ]
}

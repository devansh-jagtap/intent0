{
  "name": "intent0",
  "version": "0.0.1",
  "description": "Add an intent bar to an existing website: users say what they want, intent0 builds the steps live from approved actions.",
  "homepage": "https://github.com/devansh-jagtap/intent0#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/devansh-jagtap/intent0.git",
    "directory": "packages/intent0"
  },
  "bugs": {
    "url": "https://github.com/devansh-jagtap/intent0/issues"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "intent0": "./dist/cli.js"
  },
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "pack:local": "pnpm pack",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@intent0/adapter": "workspace:*",
    "@intent0/core": "workspace:*",
    "@intent0/react": "workspace:*",
    "@intent0/schema": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "node-html-parser": "^9.0.4",
    "preact": "^11.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}


# intent0 model settings. Copy this file to .env.local and fill it in yourself.
# Leave LLM_API_KEY empty to use the built-in mock model (keyword matching + template pages).
# Any OpenAI-compatible endpoint works. Examples:
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1
#   NVIDIA: LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1   (no key needed)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
